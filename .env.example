# Google OAuth (client "friends-leaderboard-web" in project friends-leaderboard-503615)
GOOGLE_CLIENT_ID=917279990230-94ofjtoptk6k9df907oppqp2dnjhcu4s.apps.googleusercontent.com
# Paste from the client-secret JSON the owner downloaded. NEVER commit.
GOOGLE_CLIENT_SECRET=

# Public base URL of the app (no trailing slash). Local dev:
APP_URL=http://localhost:3000

# Postgres (Neon / Supabase pooled connection string)
DATABASE_URL=

# Long random string; signs session cookies and encrypts stored tokens.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# The invite code friends must enter before connecting
INVITE_CODE=

# Bearer secret for the /api/sync cron endpoint (Vercel sets the header automatically
# when this env var exists). Generate with: openssl rand -hex 24
CRON_SECRET=

# Optional: set to "1" to render the leaderboards with fake demo data (no DB needed)
DEMO_MODE=
