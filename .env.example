# Google OAuth web client (create your own in console.cloud.google.com — see README)
GOOGLE_CLIENT_ID=
# Client secret from the same OAuth client. NEVER commit.
GOOGLE_CLIENT_SECRET=

# Public base URL of the app (no trailing slash). Local dev:
APP_URL=http://localhost:3000

# Postgres (local, Neon, or Supabase connection string)
DATABASE_URL=

# Long random string; signs session cookies and encrypts stored tokens.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# The invite code friends must enter before connecting
INVITE_CODE=

# Bearer secret for the /api/sync cron endpoint (Vercel sends the header
# automatically when this env var exists). Generate with: openssl rand -hex 24
CRON_SECRET=

# Optional: set to "1" to render the app with fake demo data (no DB needed)
DEMO_MODE=
